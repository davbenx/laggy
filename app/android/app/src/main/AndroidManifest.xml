<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Trasloco dei dati dalla vecchia app (TWA): il sito rimanda qui
                 con notturnisti://import#<dati>. Vedi migrate.js. Niente App
                 Links su https://app.notturnisti.club per ora: aprire il sito
                 dall'app per esportare i dati deve finire nel browser, non
                 tornare qui. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="notturnisti" android:host="import" />
            </intent-filter>

        </activity>

        <!-- Widget "Il tuo piano" (NotturnistiWidget.java). -->
        <receiver
            android:name=".NotturnistiWidget"
            android:label="@string/widget_etichetta"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_piano_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calendario del telefono: l'app scrive (e rilegge, per ritrovare il
         proprio) il calendario locale "Notturnisti". Chiesto solo quando si
         attiva la sincronizzazione. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Sveglia nell'app Orologio (AlarmPlugin): permesso normale, concesso
         all'installazione senza chiedere niente. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
</manifest>
