                android:layout_marginTop="2dp" android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <!-- Mese: dal widget alto almeno ~280 dp. La griglia è un'immagine disegnata in codice
         (MeseWidget); sopra, caselle trasparenti uguali alle celle, una per giorno, per il tocco
         («apri l'app su quel giorno») e per TalkBack. -->
