                <FrameLayout android:id="@+id/w_m_c36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
