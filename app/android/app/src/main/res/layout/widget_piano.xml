<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Il tuo piano". Contenuto centrato in verticale: lo spazio che
     avanza (widget alto ma non abbastanza per la settimana) si divide sopra e
     sotto invece di restare tutto in fondo. I testi qui sono anche l'anteprima nel selettore
     dei widget; quelli veri li mette NotturnistiWidget. Colori in
     values/widget_colori.xml e values-night/ (segue il tema del telefono). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/widget_sfondo">

    <TextView
        android:id="@+id/w_etichetta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adesso"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textColor="@color/w_dim"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/w_riga_adesso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_icona_sfondo">
            <ImageView
                android:id="@+id/w_icona"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_w_sonno"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/w_adesso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sonno"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/w_ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_sotto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="fino alle 07:20 · ancora 2 h 10"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/w_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progresso"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="600"
        android:progressTint="@color/w_accento"
        android:progressBackgroundTint="@color/w_chip" />

    <!-- Diario dal widget, la mattina: due o tre risposte a un tocco. -->
    <LinearLayout
        android:id="@+id/w_diario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/w_db1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/widget_bottone_pri" android:text="Sì, così"
            android:textColor="@color/w_su_accento" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_db2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/widget_bottone" android:text="Altri orari"
            android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_db3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:layout_marginStart="6dp" android:gravity="center" android:background="@drawable/widget_bottone" android:text="Bene"
            android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_prossimi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:id="@+id/w_p1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_p1_ic" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_w_luce" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_p1_ora" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="07:35" android:textColor="@color/w_ink" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_p1_t" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Luce" android:textColor="@color/w_dim"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_p2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_p2_ic" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_w_turno" android:importantForAccessibility="no" />
            <TextView android:id="@+id/w_p2_ora" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="14:00" android:textColor="@color/w_ink" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_p2_t" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Turno Pomeriggio" android:textColor="@color/w_dim"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Settimana: solo se il widget è alto almeno 3 righe. Un tocco su un
         giorno apre l'app su quel giorno. -->
    <LinearLayout
        android:id="@+id/w_settimana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout android:id="@+id/w_g0" android:layout_width="0dp" android:layout_height="wrap_content"
