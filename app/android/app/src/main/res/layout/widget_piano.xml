                <FrameLayout android:id="@+id/w_m_c4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_m_r1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                <FrameLayout android:id="@+id/w_m_c7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_m_c10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
