                android:gravity="center" android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:background="@drawable/widget_cella_riposo" />
            <TextView android:id="@+id/w_g0_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_g1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="3dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/w_g1_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_g1_c" android:layout_width="match_parent" android:layout_height="26dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginTop="2dp"
                android:gravity="center" android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:background="@drawable/widget_cella_riposo" />
            <TextView android:id="@+id/w_g1_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_g2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="3dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/w_g2_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_g2_c" android:layout_width="match_parent" android:layout_height="26dp"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:layout_marginTop="2dp"
                android:gravity="center" android:textColor="@color/w_ink" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:background="@drawable/widget_cella_riposo" />
            <TextView android:id="@+id/w_g2_s" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_g3" android:layout_width="0dp" android:layout_height="wrap_content"
