<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 di default, ridimensionabile. updatePeriodMillis è solo la rete di
     sicurezza (minimo consentito 30 min): il ridisegno vero è programmato al
     prossimo cambio di attività (NotturnistiWidget). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_piano"
    android:previewLayout="@layout/widget_piano"
    android:description="@string/widget_descrizione" />
