<?xml version="1.0" encoding="utf-8"?>
<!-- Backup di Android (fino ad Android 11): solo i dati dell'app che stanno nella pagina
     (turni, diario, impostazioni: il «localStorage» del WebView). Il resto è del telefono
     (widget, cache, calendari) e si rifà da solo sul telefono nuovo. -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage"/>
</full-backup-content>
