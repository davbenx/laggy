<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 e successivi: stesse regole per il backup su Google e per il trasloco da telefono a telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage"/>
    </device-transfer>
</data-extraction-rules>
